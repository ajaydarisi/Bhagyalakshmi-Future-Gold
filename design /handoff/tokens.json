{
  "$schema": "https://design-tokens.org/format",
  "$meta": {
    "name": "Bhagyalakshmi Future Gold — Design Tokens",
    "source": "BFG Design System (ui_kits prototypes)",
    "aesthetic": "Modern luxe — gold hero on warm ivory/sand neutrals, deep bridal maroon accent",
    "consumeWith": "Tailwind CSS v4 @theme (CSS variables) — see tokens.css"
  },
  "color": {
    "gold": {
      "100": "#F7EAD0", "200": "#EFD9A8", "300": "#E6C77E", "400": "#D4AC5A",
      "500": "#B98A38", "600": "#9A6F2A", "700": "#7A5620",
      "rgb": "185 138 56", "deepRgb": "122 86 32"
    },
    "maroon": { "400": "#9A4453", "500": "#7A2E3A", "600": "#5E2230" },
    "neutral": {
      "ivory50": "#FCFAF6", "ivory100": "#F8F2E8", "sand200": "#F1E9DA", "sand300": "#E6DAC6",
      "taupe400": "#CDBDA3", "taupe500": "#A8946F", "stone600": "#7C6F5B", "stone700": "#574E40",
      "ink800": "#2E2820", "ink900": "#1C1812", "white": "#FFFFFF"
    },
    "functional": {
      "success": "#3B7A4F", "successBg": "#E8F1E9", "successBorder": "#C7E0CE",
      "error": "#B03A2E", "errorBg": "#F7E9E6", "errorBorder": "#ECC9C2",
      "warning": "#9A6B16", "warningBg": "#FBF1DE", "warningBorder": "#F0DCB4",
      "info": "#3A5A86", "infoBg": "#ECEFF4", "infoBorder": "#CFD9E6"
    },
    "semantic": {
      "bgPage": "ivory100", "bgPageWarm": "#F4EADA", "surfaceCard": "white", "surfaceSubtle": "ivory50",
      "surfaceSand": "sand200", "surfaceInk": "ink900",
      "textPrimary": "ink900", "textBody": "ink800", "textSecondary": "stone600", "textMuted": "taupe500",
      "textOnGold": "ivory50", "textOnDark": "ivory100", "textGold": "gold700",
      "border": "sand300", "borderStrong": "taupe400", "borderGold": "rgb(185 138 56 / 0.45)",
      "divider": "rgb(122 86 32 / 0.18)", "ring": "rgb(185 138 56 / 0.55)", "overlay": "rgb(28 24 18 / 0.55)"
    },
    "gradient": {
      "gold": "linear-gradient(105deg, #9A6F2A 0%, #D4AC5A 45%, #E6C77E 55%, #B98A38 100%)",
      "goldSoft": "linear-gradient(135deg, #EFD9A8 0%, #F7EAD0 100%)",
      "ivoryWarm": "linear-gradient(180deg, #FCFAF6 0%, #F4EADA 100%)",
      "ink": "linear-gradient(180deg, #251F18 0%, #1C1812 100%)",
      "foil": "linear-gradient(92deg, #7A5620 0%, #D4AC5A 40%, #E6C77E 52%, #9A6F2A 100%)"
    }
  },
  "typography": {
    "family": {
      "display": "\"Cormorant Garamond\", \"Hoefler Text\", Georgia, serif",
      "brand": "\"Marcellus\", \"Cormorant Garamond\", Georgia, serif",
      "body": "\"Hanken Grotesk\", ui-sans-serif, system-ui, -apple-system, sans-serif",
      "telugu": "\"Noto Sans Telugu\", \"Hanken Grotesk\", sans-serif"
    },
    "googleFonts": [
      "Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500",
      "Marcellus",
      "Hanken+Grotesk:wght@300;400;500;600;700",
      "Noto+Sans+Telugu:wght@400;500;600;700"
    ],
    "scaleRem": {
      "2xs": 0.6875, "xs": 0.75, "sm": 0.875, "base": 1, "lg": 1.125, "xl": 1.375,
      "2xl": 1.75, "3xl": 2.25, "4xl": 3, "5xl": 4, "6xl": 5.5
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.04, "snug": 1.18, "normal": 1.5, "relaxed": 1.7 },
    "letterSpacing": { "tight": "-0.02em", "normal": "0", "wide": "0.08em", "wider": "0.22em" },
    "role": {
      "eyebrow": "400 0.75rem/1.2 brand",
      "display": "500 5.5rem/1.04 display",
      "h1": "500 4rem/1.04 display",
      "h2": "500 3rem/1.18 display",
      "h3": "500 2.25rem/1.18 display",
      "h4": "600 1.375rem/1.18 body",
      "bodyLg": "400 1.125rem/1.7 body",
      "body": "400 1rem/1.5 body",
      "bodySm": "400 0.875rem/1.5 body",
      "label": "600 0.875rem/1.2 body",
      "caption": "500 0.75rem/1.3 body",
      "price": "600 1.375rem/1.1 body"
    }
  },
  "spacing": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem",
    "6": "2rem", "7": "2.5rem", "8": "3rem", "9": "4rem", "10": "5rem", "12": "7rem", "16": "10rem"
  },
  "layout": {
    "container": "1280px", "containerWide": "1440px", "containerProse": "680px",
    "gutter": "clamp(1.25rem, 4vw, 4rem)", "sectionY": "clamp(4rem, 9vw, 7rem)",
    "controlSm": "2.25rem", "controlMd": "2.75rem", "controlLg": "3.25rem"
  },
  "radius": { "none": "0", "sm": "4px", "md": "8px", "lg": "14px", "xl": "22px", "pill": "999px", "card": "8px" },
  "shadow": {
    "xs": "0 1px 2px rgb(122 86 32 / 0.06)",
    "sm": "0 1px 3px rgb(122 86 32 / 0.07), 0 1px 2px rgb(28 24 18 / 0.04)",
    "md": "0 4px 16px rgb(122 86 32 / 0.08), 0 2px 6px rgb(28 24 18 / 0.05)",
    "lg": "0 14px 40px rgb(122 86 32 / 0.12), 0 4px 12px rgb(28 24 18 / 0.06)",
    "xl": "0 28px 70px rgb(122 86 32 / 0.16), 0 8px 24px rgb(28 24 18 / 0.08)",
    "gold": "0 8px 24px rgb(185 138 56 / 0.32)",
    "ringFocus": "0 0 0 3px rgb(185 138 56 / 0.30)"
  },
  "motion": {
    "ease": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "soft": "cubic-bezier(0.33, 0.1, 0.25, 1)"
    },
    "duration": { "fast": "140ms", "base": "240ms", "slow": "420ms", "slower": "700ms" },
    "pressScale": 0.97, "lift": "translateY(-4px)"
  }
}
